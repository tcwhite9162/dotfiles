configuration {
    show-icons:                     true;
    drun-display-format:            "{icon}  {name}";
    click-to-exit:                  true;
    sort:                           true;

    filebrowser {
        show-hidden: true;
        directory: "/home/tcwhite/Media/Lectures/";
        sorting-method: "mtime";
    } 
}

*{
    font: "Noto Sans Mono 14";

    BG:    #00000066;  
    FG:    #e9fbfdff;  
    OFF:   #58506aff;  

    BGA:   #ddddff22;  
    BDR:   #444444ff;  
    SEL:   #555566ff;  
    PRMT:  #aaaa55ff;  
    UGT:   #ff640b44;  
}

window {
    transparency:                   "real";
    background-color:               @BG;
    text-color:                     @FG;
    border:                         2px;
    border-color:                   @BDR;
    border-radius:                  10px;
    width:                          40%;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}

scrollbar {
    handle-width: 0px;
}

prompt {
    enabled:                        true;
    padding:                        8px;
    background-color:               @BG;
    text-color:                     @FG;
    border-radius:                  10px;
}

entry {
    background-color:               @BG;
    text-color:                     #777777;
    expand:                         true;
    placeholder:                    " Search";
    blink:                          true;
    border-radius:                  10px;
    padding:                        8px;
}

inputbar {
    children:                       [entry];
    background-color:               #00000000;
    expand:                         false;
    border:                         0px 0px 0px 0px;
    border-radius:                  10px;
    border-color:                   @BDR;
    margin:                         0px 0px 0px 0px;
    padding:                        0px;
    position:                       center;
    spacing:                        5px;
}

listview {
    background-color:               transparent;
    columns:                        1;
    lines:                          5;
    spacing:                        4px;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
    border:                         0px;
}

mainbox {
    background-color:               @BG;
    children:                       [ inputbar, listview ];
    spacing:                        15px;
    padding:                        15px;
    border-radius:                  10px;
}

element {
    background-color:               transparent;
    text-color:                     @FG;
    orientation:                    horizontal;
    border-radius:                  10px;
    padding:                        12px;
}

// element normal.normal {
//     background-color:               transparent;
//     text-color:                     @FG;
//     orientation:                    horizontal;
//     padding:                        12px;
// }

element normal.normal {
    background-color: transparent;
    text-color: @FG;
    padding: 12px;
}

element selected.normal {
    background-color:               @BGA;
    text-color:                     @FG;
    orientation:                    horizontal;
    padding:                        12px;
}

element alternate.normal {
    background-color:               transparent;
    text-color:                     @FG;
    orientation:                    horizontal;
    padding:                        12px;
}
