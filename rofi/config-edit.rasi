/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* KooL Hyprland Edit Rofi Config */
@import "~/.config/rofi/config.rasi"

/* ---- Override Color Definitions for config-edit ---- */
* {

    // BG:    #00000066;  /* deep background */
    // FG:    #e9fbfdff;  /* light text  */
    // OFF:   #58506aff;  /* dim text  */
    //
    // /* Light blue Catppuccin accents */
    // BGA:   #445566aa;  /* selection box  */
    // BDR:   #444444ff;  /* border  */
    // SEL:   #777799ff;  /* prompt highlight  */
    // UGT:   #ff640b44;  /* urgent  */

    /* Dark neutral base */
    BG:    #00000066;  /* main background  */
    FG:    #e9fbfdff;  /* text  */
    OFF:   #50516aff;  /* dimmed text  */

    /* Light blue Catppuccin accents */
    BGA:   #55557788;  /* selection box  */
    BDR:   #666666ff;  /* border  */
    SEL:   #555566ff;  /* top left prompt box */
    UGT:   #fe640b44;  /* urgent  */
    MSG:   #77778888;  /* message box background  */
    MTXT:  #000000cc;  /* message box text  */
}


/* ---- Window ---- */
window {
    transparency:                   "reaDl";
    background-color:               @BG;
    text-color:                     @FG;
    border:                         2px;
    border-color:                   @BDR;
    border-radius:                  10px;
    width:                          70%;
    height:                         inherit;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}

/* ---- Prompt ---- */
prompt {
    enabled:                        true;
    padding:                        8px;
    background-color:               @BG;
    text-color:                     @FG;
    border-radius:                  10px;
}

textbox-prompt-colon {
    expand:                         false;
    str:                            "≫"; 
    border-radius:                  10px;
    background-color:               @SEL;
    text-color:                     #ffff99ff;
    padding:                        4px 12px;
    font:                           "Iosevka Nerd Font Bold 12";
    vertical-align:                 0.5;
    horizontal-align:               0.5;
}

/* ---- Entry input ---- */
entry {
    background-color:               @BG;
    text-color:                     #eeeeee;
    placeholder-color:              @FG;
    expand:                         true;
    horizontal-align:               0.5;
    placeholder:                    " Search";
    blink:                          true;
    border:                         0px 0px 2px 0px;
    border-color:                   @BDR;
    border-radius:                  10px;
    padding:                        8px;
}

textbox-hint {
    expand:                         false;
    str:                            "CTRL TAB to change MODE";
    background-color:               @BG;
    text-color:                     @OFF;
    horizontal-align:               1;
    padding:                        8px;
    border-radius:                  10px;
}

prompt-wrapper {
    expand:                         false;
    vertical-align:                 0.5;
    background-color:               transparent;
    children:                       [ textbox-prompt-colon ];
    margin:                         6px 0px 0px 0px;
}

/* ---- Inputbar ---- */
inputbar {
    children:                       [ prompt-wrapper, entry, textbox-hint ];
    background-color:               @BG;
    text-color:                     #eeeeee;
    expand:                         false;
    border:                         0px 0px 0px 0px;
    border-radius:                  10px;
    border-color:                   @BDR;
    margin:                         0px 0px 0px 0px;
    padding:                        0px;
    position:                       center;
    spacing:                        5px;
}

/* ---- Case Indicator ---- */
case-indicator {
    background-color:               @BG;
    text-color:                     @FG;
    spacing:                        0;
    border-radius:                  10px;
}

/* ---- Listview ---- */
listview {
    background-color:               @BG;
    columns:                        3;
    lines:                          6;
    spacing:                        6px;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
    border-radius:                  10px;
    fixed-height:                   false;
    scrollbar:                      true;
}

/* ---- Scrollbar ---- */
scrollbar {
    border:                         0px;
    border-radius:                  10px;
    background-color:               transparent;
    handle-color:                   @BDR;
    handle-width:                   2px;
    padding:                        0;
}

/* ---- Mainbox ---- */
mainbox {
    background-color:               @BG;
    children:                       [ inputbar, message, listview ];
    spacing:                        15px;
    padding:                        15px;
    border-radius:                  10px;
}

/* ---- Elements ---- */
element {
    background-color:               transparent;
    text-color:                     @FG;
    orientation:                    horizontal;
    border-radius:                  10px;
    padding:                        12px;
}

element-text {
    background-color:               transparent;
    text-color:                     inherit;
    expand:                         true;
    horizontal-align:               0.0;
    vertical-align:                 0.5;
    margin:                         0px;
    padding:                        0px;
    border-radius:                  10px;
}

element-icon {
    background-color:               transparent;
    text-color:                     inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           0%;
    border:                         0px;
    border-radius:                  10px;
}

element normal.urgent,
element alternate.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
    border-radius:                  10px;
}

element normal.active,
element alternate.active {
    background-color:               @BGA;
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected {
    background-color:               @BGA;
    text-color:                     @FG;
    border:                         0px;
    border-radius:                  10px;
}

element-text selected {
    background-color:               transparent;
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected.active {
    background-color:               @BGA;
    color:                          @FG;
    border-radius:                  10px;
}

/* ---- Message ---- */
message {
    background-color:               transparent;
    border:                         0px;
    border-radius:                  10px;
}

error-message {
    padding:                        20px;
    border-radius:                  10px;
}

textbox {
    padding:                        10px;
    border-radius:                  10px;
    background-color:               @MSG;      /* NOW USING SEPARATE MSG COLOR! */
    text-color:                     @MTXT;
    vertical-align:                 0.5;
    horizontal-align:               0.5;
}

/* ---- Configuration ---- */ 
configuration {
    modi:                           "drun";
}
