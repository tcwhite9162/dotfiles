/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* KooL Style LonerOrZ — palette aligned to Kitty with consistent transparency */

configuration {
    show-icons:                     true;
    display-drun:                   "";
    drun-display-format:            "{icon}  {name}";
    disable-history:                false;
    click-to-exit:                  true;
    location:                       0;
    sorting-method:                 "fzf";
    sort:                           false;
}

/*****----- Global Properties -----*****/
* {
    font: "Noto Sans Mono 14";

    /* Dark neutral base */
    BG:    #00000066;  /* deep background */
    FG:    #e9fbfdff;  /* light text  */
    OFF:   #58506aff;  /* dim text  */

    /* Light blue Catppuccin accents */
    BGA:   #55557788;  /* selection box  */
    BDR:   #444444ff;  /* border  */
    SEL:   #555566ff;  /* prompt highlight  */
    UGT:   #ff640b44;  /* urgent  */
}

window {
    transparency:                   "real";
    background-color:               @BG;
    text-color:                     @FG;
    border:                         2px;
    border-color:                   @BDR;
    border-radius:                  10px;
    width:                          35%;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}

prompt {
    enabled:                        true;
    padding:                        8px;
    background-color:               @BG;
    text-color:                     @FG;
    border-radius:                  10px;
}

/* alternate icons: "→" "▶" "❯" "»" "⟩" ">" "⟹" "⇒" "⇨" "→" "⟼"*/
textbox-prompt-colon {
    expand:                         false;
    str:                            "≫"; 
    border-radius:                  10px;
    background-color:               @SEL;
    text-color:                     #ffff99ff;
    padding:                        4px 12px;
    font:                           "Iosevka Nerd Font Bold 12";
    vertical-align:                 0.5;
    horizontal-align:               0.5;
}

entry {
    background-color:               @BG;
    text-color:                     #eeeeee;
    placeholder-color:              @FG;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    " Search";
    blink:                          true;
    border:                         0px 0px 2px 0px;
    border-color:                   @BDR;
    border-radius:                  10px;
    padding:                        8px;
}

textbox-hint {
    expand:                         false;
    str:                            "CTRL TAB to change MODE";
    background-color:               @BG;
    text-color:                     @OFF;  /* dimmed color */
    horizontal-align:               1;  /* right align */
    padding:                        8px;
    border-radius:                  10px;
}

prompt-wrapper {
    expand:                         false;
    vertical-align:                 0.5;
    background-color:               transparent;
    children:                       [ textbox-prompt-colon ];
    margin:                         6px 0px 0px 0px;
}

inputbar {
    children:                       [ prompt-wrapper, entry, textbox-hint ];
    background-color:               @BG;
    text-color:                     #eeeeee;
    expand:                         false;
    border:                         0px 0px 0px 0px;
    border-radius:                  10px;
    border-color:                   @BDR;
    margin:                         0px 0px 0px 0px;
    padding:                        0px;
    position:                       center;
    spacing:                        5px;
}

case-indicator {
    background-color:               @BG;
    text-color:                     @FG;
    spacing:                        0;
    border-radius:                  10px;
}

listview {
    background-color:               @BG;
    columns:                        1;
    lines:                          7;
    spacing:                        4px;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
    border-radius:                  10px;
}

scrollbar {
  border:                           0px;
  border-radius:                    10px;
  background-color:                 transparent;
  handle-color:                     @BDR;
  handle-width:                     2px;
  padding:                          0;
}

mainbox {
    background-color:               @BG;
    children:                       [ inputbar, message, listview ];
    spacing:                        15px;
    padding:                        15px;
    border-radius:                  10px;
}

element {
    background-color:               transparent;
    text-color:                     @FG;
    orientation:                    horizontal;
    border-radius:                  10px;
    padding:                        12px;
}

element-text {
    background-color:               transparent;  /* change from inherit */
    text-color:                     inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         2px 0px 2px 2px;
    border-radius:                  10px;
}

element-icon {
    background-color:               transparent;  /* change from inherit */
    text-color:                     inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           24px;
    border:                         0px;
    border-radius:                  10px;
}

element normal.urgent,
element alternate.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
    border-radius:                  10px;
}

element normal.active,
element alternate.active {
    background-color:               @BGA;
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected {
    background-color:               @BGA;
    text-color:                     @FG;
    border:                         0px;
    border-radius:                  10px;
}

element-text selected {
    background-color:               transparent;  /* or inherit */
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected.urgent {
    background-color:               @UGT;
    text-color:                     @FG;
    border-radius:                  10px;
}

element selected.active {
    background-color:               @BGA;
    color:                          @FG;
    border-radius:                  10px;
}

/*****----- Message -----*****/
message {
    background-color:               transparent;
    border:                         0px;
    border-radius:                  10px;
}
error-message {
    padding:                        20px;
    border-radius:                  10px;
}
textbox {
    padding:                        10px;
    border-radius:                  10px;
    background-color:               @BDR;  /* semi-transparent border color as fill */
    text-color:                     @SEL;  /* readable accent text */
    vertical-align:                 0.5;
    horizontal-align:               0.5;
}
