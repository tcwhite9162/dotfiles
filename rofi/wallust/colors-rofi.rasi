 /* wallust template - colors-rofi */

* {
active-background: #6D6D6D;
active-foreground: #DFDFDF;
normal-background: #222222;
normal-foreground: #DFDFDF;
urgent-background: #939393;
urgent-foreground: #DFDFDF;

alternate-active-background: #626262;
alternate-active-foreground: #DFDFDF;
alternate-normal-background: #222222;
alternate-normal-foreground: #DFDFDF;
alternate-urgent-background: #222222;
alternate-urgent-foreground: #DFDFDF;

selected-active-background: #939393;
selected-active-foreground: #DFDFDF;
selected-normal-background: #939393;
selected-normal-foreground: #DFDFDF;
selected-urgent-background: #6D6D6D;
selected-urgent-foreground: #DFDFDF;

background-color: #222222;
background: rgba(0,0,0,0.7);
foreground: #DFDFDF;
border-color: #6D6D6D;

color0: #484848;
color1: #191919;
color2: #202020;
color3: #4A4A4A;
color4: #525252;
color5: #6E6E6E;
color6: #7A7A7A;
color7: #C9C9C9;
color8: #8C8C8C;
color9: #222222;
color10: #2A2A2A;
color11: #626262;
color12: #6D6D6D;
color13: #939393;
color14: #A3A3A3;
color15: #C9C9C9;


}

